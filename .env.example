# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://usv:usv@localhost:5432/unified_shipping?schema=public
SHADOW_DATABASE_URL=postgresql://usv:usv@localhost:5432/unified_shipping_shadow?schema=public

# --- Redis (queues + cache + idempotency) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-please-32-bytes-minimum-aaaaa
API_KEY_PEPPER=change-me-please-32-bytes-minimum-bbbbb
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme

# --- Public URLs ---
API_PUBLIC_URL=http://localhost:3000
DASHBOARD_PUBLIC_URL=http://localhost:3001
WEBHOOK_INGEST_BASE_URL=http://localhost:3000/v1/webhooks

# --- Carrier credentials (per-merchant in DB; these are for dev fixtures only) ---
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=

GHTK_BASE_URL=https://services.giaohangtietkiem.vn
GHTK_TOKEN=

JNT_BASE_URL=https://demoopenapi.jtexpress.vn
JNT_API_ACCOUNT=
JNT_PRIVATE_KEY=

VTP_BASE_URL=https://partner.viettelpost.vn
VTP_USERNAME=
VTP_PASSWORD=

NINJAVAN_BASE_URL=https://api-sandbox.ninjavan.co
NINJAVAN_CLIENT_ID=
NINJAVAN_CLIENT_SECRET=
NINJAVAN_COUNTRY=vn

# --- KMS / envelope encryption ---
# Provider: "local" (dev / CI) or "aws-kms" (prod).
USV_KMS_PROVIDER=local
# The KEK identifier used to seal new secrets. Existing secrets carry their
# own keyId in the envelope, so rotation works by changing this value.
USV_KMS_DEFAULT_KEY_ID=primary
# Local provider — at least one KEK is required. Base64-encoded 32 random bytes.
# Generate with:  openssl rand -base64 32
USV_KMS_LOCAL_KEK_primary=REPLACE_ME_BASE64_32_BYTES
# AWS provider — leave blank when not using.
# AWS_REGION=ap-southeast-1
# USV_KMS_AWS_ENDPOINT=                              # optional, for LocalStack

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=usv-api
SENTRY_DSN=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT_RPM=600
