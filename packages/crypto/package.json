{
  "name": "@usv/crypto",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./providers/local": { "types": "./dist/providers/local.d.ts", "import": "./dist/providers/local.js" },
    "./providers/aws-kms": { "types": "./dist/providers/aws-kms.d.ts", "import": "./dist/providers/aws-kms.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@usv/core": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-kms": "^3.x"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-kms": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
