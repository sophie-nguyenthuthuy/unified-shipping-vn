{
  "name": "@usv/worker",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@usv/config": "workspace:*",
    "@usv/core": "workspace:*",
    "@usv/crypto": "workspace:*",
    "@usv/db": "workspace:*",
    "@usv/observability": "workspace:*",
    "@usv/reconciliation": "workspace:*",
    "@usv/webhooks": "workspace:*",
    "bullmq": "^5.10.4",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.22.5",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
